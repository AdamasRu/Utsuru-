--- !u!114 &2126839627
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2126839626}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3cb78950c9ed50e4fad8a5dd73561063, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCSpawner
  npcPrefab: {fileID: 4401379776115542181, guid: 55ba48d27b5dfac479aa79cc07a2f35a, type: 3}
  spawnLocations:
  - locationName: VendingMachine
    pointTransform: {fileID: 1086252200}
    locationQuestions:
    - npcName: Aoi
      avatarPortrait: {fileID: 0}
      roleTag: Local Resident
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u81EA\u8CA9\u6A5F\u306B\u304A\u672D\u304C\u5165\u3089\u306A\u3044\u306A\u2026\u5C0F\u92AD\u6301\u3063\u3066\u308B\uFF1F\u300D"
      questionRomaji: (Jihanki ni osatsu ga hairanai na... Kozeni motteru?)
      questionEnglish: '"The vending machine won''t take bills... Do you have any
        coins?"'
      choices:
      - choiceText: "\u300C100\u5186\u7389\u306A\u3089\u3042\u308A\u307E\u3059\u3088\u3002\u300D"
        choiceRomaji: (Hyaku-en dama nara arimasu yo.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u3042\u308A\u304C\u3068\u3046\uFF01\u52A9\u304B\u3063\u305F\u3088\u3001\u3053\u308C\u3067\u30B8\u30E5\u30FC\u30B9\u304C\u8CB7\u3048\u308B\uFF01\u300D"
        npcResponseRomaji: (Arigatou! Tasukatta yo, kore de juusu ga kaeru!)
        npcResponseEnglish: '"Thank you! You saved me, now I can buy juice!"'
      - choiceText: "\u300C\u81EA\u8CA9\u6A5F\u306F\u5ACC\u3044\u3067\u3059\u3002\u300D"
        choiceRomaji: (Jihanki wa kirai desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3048\u3063\u3001\u81EA\u8CA9\u6A5F\u304C\u5ACC\u3044\u306A\u306E\u2026\uFF01\uFF1F\u4FBF\u5229\u306A\u306E\u306B\u301C\uFF01\u300D"
        npcResponseRomaji: (E', jihanki ga kirai na no...!? Benri na no ni~!)
        npcResponseEnglish: "\"Eh, you hate vending machines...!? Even though they're
          so convenient\u301C!\""
      - choiceText: "\u300C\u304A\u8336\u304C\u98F2\u307F\u305F\u3044\u3067\u3059\u3002\u300D"
        choiceRomaji: (Ocha ga nomitai desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3042\u306F\u306F\u3001\u541B\u3082\u304A\u8336\u304C\u98F2\u307F\u305F\u3044\u3093\u3060\u306D\uFF01\u3067\u3082\u5C0F\u92AD\u304C\u306A\u3044\u3093\u3060\u2026\u300D"
        npcResponseRomaji: (Ahaha, kimi mo ocha ga nomitai n da ne! Demo kozeni ga
          nai n da...)
        npcResponseEnglish: '"Hahaha, you want to drink tea too! But I don''t have
          any coins..."'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: Toko
    pointTransform: {fileID: 204139229}
    locationQuestions:
    - npcName: Ren
      avatarPortrait: {fileID: 0}
      roleTag: Shopkeeper
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u3044\u3089\u3063\u3057\u3083\u3044\uFF01\u4F55\u3092\u63A2\u3057\u3066\u3044\u308B\u306E\u304B\u3044\uFF1F\u300D"
      questionRomaji: (Irasshai! Nani o sagashite iru no kai?)
      questionEnglish: '"Welcome! What are you looking for?"'
      choices:
      - choiceText: "\u300C\u304A\u3059\u3059\u3081\u306E\u304A\u83D3\u5B50\u3092\u304F\u3060\u3055\u3044\u3002\u300D"
        choiceRomaji: (Osusume no okashi o kudasai.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u6BCE\u5EA6\u3042\u308A\uFF01\u3053\u306E\u304A\u714E\u9905\u304C\u713C\u304D\u305F\u3066\u3067\u304A\u3059\u3059\u3081\u3060\u3088\uFF01\u300D"
        npcResponseRomaji: (Maido ari! Kono osenbei ga yakitate de osusume da yo!)
        npcResponseEnglish: '"Thank you! These freshly baked rice crackers are my
          recommendation!"'
      - choiceText: "\u300C\u4F55\u3082\u8CB7\u3044\u307E\u305B\u3093\u3002\u300D"
        choiceRomaji: (Nanimo kaimasen.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u898B\u308B\u3060\u3051\u3067\u3082\u5927\u6B53\u8FCE\u3060\u3088\uFF01\u3086\u3063\u304F\u308A\u3057\u3066\u3044\u3063\u3066\u306D\u3002\u300D"
        npcResponseRomaji: (Miru dake demo daikangei da yo! Yukkuri shite itte ne.)
        npcResponseEnglish: '"Just looking is very welcome too! Take your time."'
      - choiceText: "\u300C\u3053\u3053\u306F\u3069\u3053\u3067\u3059\u304B\uFF1F\u300D"
        choiceRomaji: (Koko wa doko desu ka.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3053\u3053\u306F\u99C4\u83D3\u5B50\u5C4B\u3060\u3088\uFF01\u8FF7\u5B50\u306B\u306A\u3063\u3061\u3083\u3063\u305F\u306E\u304B\u3044\uFF1F\u300D"
        npcResponseRomaji: (Koko wa dagashiya da yo! Maigo ni natchatta no kai?)
        npcResponseEnglish: '"This is a traditional candy shop! Did you get lost?"'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: Sampah
    pointTransform: {fileID: 1129195877}
    locationQuestions:
    - npcName: Sora
      avatarPortrait: {fileID: 0}
      roleTag: Eco Neighbor
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u30DA\u30C3\u30C8\u30DC\u30C8\u30EB\u306E\u30AD\u30E3\u30C3\u30D7\u306F\u5916\u3057\u3066\u6368\u3066\u308B\u3093\u3060\u3063\u3051\uFF1F\u300D"
      questionRomaji: (Pettobotoru no kyappu wa hazushite suterun dakke?)
      questionEnglish: '"Do we take off the plastic bottle cap before throwing it
        away?"'
      choices:
      - choiceText: "\u300C\u5DDD\u306B\u6368\u3066\u307E\u3057\u3087\u3046\u3002\u300D"
        choiceRomaji: (Kawa ni sutemashou.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u30B3\u30E9\u30B3\u30E9\uFF01\u5DDD\u306B\u30B4\u30DF\u3092\u6368\u3066\u3061\u3083\u7D76\u5BFE\u306B\u30C0\u30E1\u3060\u3088\uFF01\u300D"
        npcResponseRomaji: (Kora kora! Kawa ni gomi o sutecha zettai ni dame da yo!)
        npcResponseEnglish: '"Hey now! You must never throw trash into the river!"'
      - choiceText: "\u300C\u306F\u3044\u3001\u30AD\u30E3\u30C3\u30D7\u306F\u5225\u3067\u3059\u3088\u3002\u300D"
        choiceRomaji: (Hai, kyappu wa betsu desu yo.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u3084\u3063\u3071\u308A\u305D\u3046\u3060\u3088\u306D\uFF01\u5206\u5225\u30EB\u30FC\u30EB\u3092\u6559\u3048\u3066\u304F\u308C\u3066\u52A9\u304B\u3063\u305F\u3088\u3002\u300D"
        npcResponseRomaji: (Yappari sou da yo ne! Bunbetsu ruuru o oshiete kurete
          tasukatta yo.)
        npcResponseEnglish: '"I knew it! Thanks for reminding me of the sorting rules."'
      - choiceText: "\u300C\u6C34\u304C\u51B7\u305F\u3044\u3067\u3059\u306D\u3002\u300D"
        choiceRomaji: (Mizu ga tsumetai desu ne.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3048\u3063\uFF1F\u6C34\u306E\u8A71\u2026\uFF1F\u4ECA\u306F\u30B4\u30DF\u306E\u5206\u5225\u306E\u8A71\u3060\u3088\u301C\uFF01\u300D"
        npcResponseRomaji: (E'? Mizu no hanashi...? Ima wa gomi no bunbetsu no hanashi
          da yo~)
        npcResponseEnglish: "\"Eh? Cold water...? We're talking about trash sorting
          right now\u301C!\""
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: Bunga
    pointTransform: {fileID: 2111093680}
    locationQuestions:
    - npcName: Kaoru
      avatarPortrait: {fileID: 0}
      roleTag: Garden Lover
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u3053\u306E\u304A\u82B1\u3001\u7DBA\u9E97\u306B\u54B2\u3044\u305F\u3067\u3057\u3087\u3046\uFF1F\u300D"
      questionRomaji: (Kono ohana, kirei ni saita deshou?)
      questionEnglish: '"These flowers bloomed beautifully, don''t you think?"'
      choices:
      - choiceText: "\u300C\u304A\u82B1\u3092\u98DF\u3079\u307E\u3059\u3002\u300D"
        choiceRomaji: (Ohana o tabemasu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u98DF\u3079\u3061\u3083\u30C0\u30E1\u3060\u3088\uFF01\u89B3\u8CDE\u7528\u306E\u304A\u82B1\u306A\u3093\u3060\u304B\u3089\u301C\uFF01\u300D"
        npcResponseRomaji: (Tabecha dame da yo! Kanshou-you no ohana nan dakara~!)
        npcResponseEnglish: "\"Don't eat them! They're decorative flowers\u301C!\""
      - choiceText: "\u300C\u3061\u3087\u3063\u3068\u90AA\u9B54\u3067\u3059\u306D\u3002\u300D"
        choiceRomaji: (Chotto jama desu ne.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3046\u30FC\u3093\u3001\u9053\u306B\u306F\u307F\u51FA\u3055\u306A\u3044\u3088\u3046\u306B\u5C11\u3057\u7247\u4ED8\u3051\u3088\u3046\u304B\u306A\u2026\u300D"
        npcResponseRomaji: (Uun, michi ni hamidasanai you ni sukoshi katazukeyou
          kana...)
        npcResponseEnglish: '"Hmm, maybe I should tidy them up so they don''t block
          the path..."'
      - choiceText: "\u300C\u624B\u5165\u308C\u304C\u7D20\u6674\u3089\u3057\u3044\u3067\u3059\u306D\uFF01\u300D"
        choiceRomaji: (Teire ga subarashii desu ne!)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u3042\u308A\u304C\u3068\u3046\uFF01\u6BCE\u671D\u6C34\u3092\u3042\u3052\u3066\u5927\u5207\u306B\u80B2\u3066\u3066\u3044\u308B\u3093\u3060\u3088\u3002\u300D"
        npcResponseRomaji: (Arigatou! Maiasa mizu o agete taisetsu ni sodatete iru
          n da yo.)
        npcResponseEnglish: '"Thank you! I water and take good care of them every
          morning."'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: Mobil
    pointTransform: {fileID: 1613074362}
    locationQuestions:
    - npcName: Makoto
      avatarPortrait: {fileID: 0}
      roleTag: Driver
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u3053\u3053\u306B\u5C11\u3057\u8ECA\u3092\u6B62\u3081\u3066\u3082\u5E73\u6C17\u304B\u306A\uFF1F\u300D"
      questionRomaji: (Koko ni sukoshi kuruma o tometemo heiki kana?)
      questionEnglish: '"Is it okay if I park my car here for a bit?"'
      choices:
      - choiceText: "\u300C\u99D0\u8ECA\u5834\u306B\u3068\u3081\u307E\u3057\u3087\u3046\u3002\u300D"
        choiceRomaji: (Chuushajou ni tomemashou.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u305D\u3046\u3060\u3088\u306D\u3001\u4ED6\u306E\u8ECA\u306E\u90AA\u9B54\u306B\u306A\u3063\u3061\u3083\u3046\u3082\u3093\u306D\uFF01\u79FB\u52D5\u3059\u308B\u3088\u3002\u300D"
        npcResponseRomaji: (Sou da yo ne, hoka no kuruma no jama ni natchau mon ne!
          Idou suru yo.)
        npcResponseEnglish: '"You''re right, it would get in the way of other cars!
          I''ll move it."'
      - choiceText: "\u300C\u8ECA\u3092\u8E74\u308A\u307E\u3059\u3002\u300D"
        choiceRomaji: (Kuruma o kerimasu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3072\u3048\u3048\u3063\u3001\u8ECA\u3092\u8E74\u3089\u306A\u3044\u3067\uFF01\u3059\u3050\u79FB\u52D5\u3055\u305B\u308B\u304B\u3089\u301C\uFF01\u300D"
        npcResponseRomaji: (Hieee, kuruma o keranaide! Sugu idou saseru kara~!)
        npcResponseEnglish: "\"Eeeek, don't kick the car! I'll move it right away\u301C!\""
      - choiceText: "\u300C\u8ECA\u304C\u5927\u304D\u3044\u3067\u3059\u3002\u300D"
        choiceRomaji: (Kuruma ga ookii desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3042\u306F\u306F\u3001\u78BA\u304B\u306B\u3061\u3087\u3063\u3068\u5927\u304D\u3044\u304B\u3082\uFF01\u3060\u304B\u3089\u3053\u305D\u3061\u3083\u3093\u3068\u99D0\u8ECA\u5834\u306B\u5165\u308C\u306A\u304D\u3083\u306D\u3002\u300D"
        npcResponseRomaji: (Ahaha, tashika ni chotto ookii kamo! Dakara koso chanto
          chuushajou ni irenakya ne.)
        npcResponseEnglish: '"Hahaha, it is a bit big indeed! All the more reason
          to park properly in a parking lot."'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: Zebracross
    pointTransform: {fileID: 418052130}
    locationQuestions:
    - npcName: Haru
      avatarPortrait: {fileID: 0}
      roleTag: Pedestrian
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u3044\u3044\u5929\u6C17\u3067\u3059\u306D\u3002\u3069\u3061\u3089\u3078\u304A\u51FA\u304B\u3051\u3067\u3059\u304B\uFF1F\u300D"
      questionRomaji: (Ii tenki desu ne. Dochira e odekake desu ka?)
      questionEnglish: '"Nice weather, isn''t it? Where are you headed?"'
      choices:
      - choiceText: "\u300C\u6563\u6B69\u3092\u3057\u3066\u3044\u308B\u3068\u3053\u308D\u3067\u3059\u3002\u300D"
        choiceRomaji: (Sanpo o shite iru tokoro desu.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u3044\u3044\u3067\u3059\u306D\uFF01\u98A8\u304C\u6C17\u6301\u3061\u3044\u3044\u304B\u3089\u3001\u304A\u6563\u6B69\u306B\u306F\u6700\u9AD8\u306E\u65E5\u3067\u3059\u3088\u3002\u300D"
        npcResponseRomaji: (Ii desu ne! Kaze ga kimochi ii kara, osanpo ni wa saikou
          no hi desu yo.)
        npcResponseEnglish: '"Sounds nice! The breeze is pleasant, it''s a great
          day for a walk."'
      - choiceText: "\u300C\u5929\u6C17\u304C\u60AA\u3044\u3067\u3059\u3002\u300D"
        choiceRomaji: (Tenki ga warui desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3048\u3063\uFF01\uFF1F\u3053\u3093\u306A\u306B\u6674\u308C\u3066\u3044\u308B\u306E\u306B\u2026\uFF1F\u4E0D\u601D\u8B70\u306A\u4EBA\u3067\u3059\u306D\u301C\uFF01\u300D"
        npcResponseRomaji: (E'!? Konna ni harete iru no ni...? Fushigi na hito desu
          ne~!)
        npcResponseEnglish: "\"Eh!? Even though it's so sunny...? You're an interesting
          person\u301C!\""
      - choiceText: "\u300C\u5BB6\u306B\u5E30\u308A\u305F\u3044\u3067\u3059\u3002\u300D"
        choiceRomaji: (Ie ni kaeritai desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3042\u3089\u3089\u3001\u75B2\u308C\u3061\u3083\u3063\u305F\u306E\u304B\u306A\uFF1F\u7121\u7406\u305B\u305A\u304A\u5BB6\u3067\u4F11\u3093\u3067\u306D\u3002\u300D"
        npcResponseRomaji: (Arara, tsukarechatta no kana? Muri sezu ouchi de yasunde
          ne.)
        npcResponseEnglish: '"Oh dear, are you tired? Don''t push yourself and rest
          at home."'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: VendingMachine2
    pointTransform: {fileID: 1777007049}
    locationQuestions:
    - npcName: Hikaru
      avatarPortrait: {fileID: 0}
      roleTag: Passerby
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u5589\u304C\u6E07\u3044\u305F\u306A\u3002\u3069\u3063\u3061\u304C\u3044\u3044\u3068\u601D\u3046\uFF1F\u300D"
      questionRomaji: (Nodo ga kawaita na. Docchi ga ii to omou?)
      questionEnglish: '"I''m thirsty. Which one do you think is good?"'
      choices:
      - choiceText: "\u300C\u304A\u8336\u304C\u304A\u3059\u3059\u3081\u3067\u3059\u3088\u3002\u300D"
        choiceRomaji: (Ocha ga osusume desu yo.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u304A\u3063\u3001\u7DD1\u8336\u3044\u3044\u306D\uFF01\u30B9\u30C3\u30AD\u30EA\u3057\u3066\u5589\u306E\u6E07\u304D\u304C\u6F64\u3044\u305D\u3046\uFF01\u300D"
        npcResponseRomaji: (O', ryokucha ii ne! Sukkiri shite nodo no kawaki ga uruoisou!)
        npcResponseEnglish: '"Oh, green tea is great! Refreshing and it will quench
          my thirst!"'
      - choiceText: "\u300C\u4F55\u3082\u98F2\u307E\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002\u300D"
        choiceRomaji: (Nanimo nomanaide kudasai.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3048\u3047\u30FC\u3063\uFF01\uFF1F\u71B1\u4E2D\u75C7\u306B\u306A\u3063\u3061\u3083\u3046\u3088\uFF01\u6C34\u5206\u88DC\u7D66\u306F\u5927\u4E8B\u3060\u3088\u301C\uFF01\u300D"
        npcResponseRomaji: (Eee-!? Netchuushou ni natchau yo! Suibun hokyuu wa daiji
          da yo~!)
        npcResponseEnglish: "\"Eeeh!? You'll get heatstroke! Staying hydrated is
          important\u301C!\""
      - choiceText: "\u300C\u6C34\u304C\u597D\u304D\u3067\u3059\u3002\u300D"
        choiceRomaji: (Mizu ga suki desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u6C34\u3082\u5065\u5EB7\u7684\u3067\u3044\u3044\u306D\uFF01\u3067\u3082\u4ECA\u65E5\u306F\u3061\u3087\u3063\u3068\u5473\u304C\u3042\u308B\u3082\u306E\u304C\u98F2\u307F\u305F\u3044\u306A\u301C\u3002\u300D"
        npcResponseRomaji: (Mizu mo kenkou-teki de ii ne! Demo kyou wa chotto aji
          ga aru mono ga nomitai na~.)
        npcResponseEnglish: "\"Water is healthy too! But today I feel like drinking
          something with flavor\u301C.\""
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: TokoTutup
    pointTransform: {fileID: 1791947863}
    locationQuestions:
    - npcName: Yuuki
      avatarPortrait: {fileID: 0}
      roleTag: Curious Shopper
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u30B7\u30E3\u30C3\u30BF\u30FC\u304C\u9589\u307E\u3063\u3066\u308B\u2026\u4ECA\u65E5\u4F11\u307F\u304B\u306A\uFF1F\u300D"
      questionRomaji: (Shattaa ga shimatteru... Kyou yasumi kana?)
      questionEnglish: '"The shutters are closed... Is it closed today?"'
      choices:
      - choiceText: "\u300C\u30C9\u30A2\u3092\u58CA\u3057\u307E\u3057\u3087\u3046\u3002\u300D"
        choiceRomaji: (Doa o kowashimashou.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u8B66\u5BDF\u547C\u3070\u308C\u3061\u3083\u3046\u3088\uFF01\u7D76\u5BFE\u306B\u58CA\u3057\u3061\u3083\u30C0\u30E1\u3060\u3088\u301C\uFF01\u300D"
        npcResponseRomaji: (Keisatsu yobarechau yo! Zettai ni kowashicha dame da
          yo~!)
        npcResponseEnglish: "\"The police will be called! You must never break it\u301C!\""
      - choiceText: "\u300C\u6C34\u66DC\u65E5\u304C\u5B9A\u4F11\u65E5\u307F\u305F\u3044\u3067\u3059\u3088\u3002\u300D"
        choiceRomaji: (Suiyoubi ga teikyuubi mitai desu yo.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u3042\u3063\u3001\u672C\u5F53\u3060\uFF01\u770B\u677F\u306B\u66F8\u3044\u3066\u3042\u308B\u306D\u3002\u6559\u3048\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\uFF01\u300D"
        npcResponseRomaji: (A', hontou da! Kanban ni kaite aru ne. Oshiete kurete
          arigatou!)
        npcResponseEnglish: '"Oh, you''re right! It''s written on the sign. Thank
          you for letting me know!"'
      - choiceText: "\u300C\u304A\u8179\u304C\u7A7A\u304D\u307E\u3057\u305F\u3002\u300D"
        choiceRomaji: (Onaka ga sukimashita.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u79C1\u3082\u304A\u8179\u7A7A\u3044\u3066\u305F\u306E\u306B\u9589\u307E\u3063\u3066\u3066\u6B8B\u5FF5\u2026\u4ED6\u306E\u304A\u5E97\u3092\u63A2\u305D\u3046\uFF01\u300D"
        npcResponseRomaji: (Watashi mo onaka suiteta no ni shimattete zannen... Hoka
          no omise o sagasou!)
        npcResponseEnglish: '"I was hungry too, such a shame it''s closed... Let''s
          look for another shop!"'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: PipadanGas
    pointTransform: {fileID: 866743239}
    locationQuestions:
    - npcName: Ibuki
      avatarPortrait: {fileID: 0}
      roleTag: Local Resident
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u58C1\u306B\u30AC\u30B9\u30E1\u30FC\u30BF\u30FC\u304C\u305F\u304F\u3055\u3093\u4E26\u3093\u3067\u3044\u3066\u9762\u767D\u3044\u306D\u3002\u300D"
      questionRomaji: (Kabe ni gasu meetaa ga takusan narande ite omoshiroi ne.)
      questionEnglish: '"There are lots of gas meters lined up on the wall, interesting
        isn''t it."'
      choices:
      - choiceText: "\u300C\u89E6\u308B\u3068\u5371\u306A\u3044\u3067\u3059\u3088\u3002\u300D"
        choiceRomaji: (Sawaru to abunai desu yo.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u305D\u3046\u3060\u306D\uFF01\u30AC\u30B9\u8A2D\u5099\u3060\u304B\u3089\u3001\u898B\u308B\u3060\u3051\u306B\u3057\u3066\u304A\u3053\u3046\u306D\u3002\u300D"
        npcResponseRomaji: (Sou da ne! Gasu setsubi dakara, miru dake ni shite okou
          ne.)
        npcResponseEnglish: '"You''re right! Since it''s gas equipment, let''s just
          look without touching."'
      - choiceText: "\u300C\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u307E\u3057\u3087\u3046\uFF01\u300D"
        choiceRomaji: (Botan o oshimashou.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u30C0\u30E1\u30C0\u30E1\uFF01\u52DD\u624B\u306B\u89E6\u3063\u305F\u3089\u8FD1\u6240\u8FF7\u60D1\u306B\u306A\u3063\u3061\u3083\u3046\u3088\uFF01\u300D"
        npcResponseRomaji: (Dame dame! Katte ni sawattara kinjo meiwaku ni natchau
          yo!)
        npcResponseEnglish: '"No no! Touching it without permission will cause trouble
          for the neighbors!"'
      - choiceText: "\u300C\u5BB6\u306B\u30AC\u30B9\u304C\u306A\u3044\u3067\u3059\u3002\u300D"
        choiceRomaji: (Ie ni gasu ga nai desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u3078\u3047\u3001\u30AA\u30FC\u30EB\u96FB\u5316\u306E\u5BB6\u306A\u306E\u304B\u306A\uFF1F\u6700\u8FD1\u306F\u5897\u3048\u3066\u308B\u3089\u3057\u3044\u306D\u3002\u300D"
        npcResponseRomaji: (Hee, ooru denka no ie na no kana? Saikin wa fueteru rashii
          ne.)
        npcResponseEnglish: '"Oh, is your home all-electric? I hear that''s becoming
          more common lately."'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: Sampah2
    pointTransform: {fileID: 819471674}
    locationQuestions:
    - npcName: Chihiro
      avatarPortrait: {fileID: 0}
      roleTag: Eco Volunteer
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u9752\u3044\u30B4\u30DF\u7BB1\u304C\u3042\u308B\u306D\u3002\u4ECA\u65E5\u306F\u8CC7\u6E90\u3054\u307F\u306E\u65E5\uFF1F\u300D"
      questionRomaji: (Aoi gomibako ga aru ne. Kyou wa shigen-gomi no hi?)
      questionEnglish: '"There''s a blue trash bin. Is today recyclable waste day?"'
      choices:
      - choiceText: "\u300C\u9053\u306B\u6368\u3066\u307E\u3057\u3087\u3046\u3002\u300D"
        choiceRomaji: (Michi ni sutemashou.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u30DD\u30A4\u6368\u3066\u306F\u7D76\u5BFE\u306B\u30C0\u30E1\u3060\u3088\uFF01\u65E5\u672C\u306E\u8857\u306F\u7DBA\u9E97\u306B\u4FDD\u305F\u306A\u304D\u3083\u306D\u3002\u300D"
        npcResponseRomaji: (Poisute wa zettai ni dame da yo! Nihon no machi wa kirei
          ni tamotanakya ne.)
        npcResponseEnglish: '"Littering is strictly forbidden! We must keep Japanese
          streets clean."'
      - choiceText: "\u300C\u9752\u8272\u306F\u5ACC\u3044\u3067\u3059\u3002\u300D"
        choiceRomaji: (Aoiro wa kirai desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u8272\u306E\u597D\u307F\u306E\u8A71\u3058\u3083\u306A\u3044\u3088\u301C\uFF01\u30B4\u30DF\u7BB1\u306E\u8272\u3067\u5206\u5225\u304C\u6C7A\u307E\u3063\u3066\u308B\u3093\u3060\u3088\u3002\u300D"
        npcResponseRomaji: (Iro no konomi no hanashi ja nai yo~! Gomibako no iro
          de bunbetsu ga kimatteru n da yo.)
        npcResponseEnglish: "\"It's not about what color you like\u301C! The bin
          color indicates the type of waste.\""
      - choiceText: "\u300C\u306F\u3044\u3001\u30EA\u30B5\u30A4\u30AF\u30EB\u306E\u65E5\u3067\u3059\u3088\u3002\u300D"
        choiceRomaji: (Hai, risaikuru no hi desu yo.)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u3088\u304B\u3063\u305F\uFF01\u7F36\u3084\u30DA\u30C3\u30C8\u30DC\u30C8\u30EB\u3092\u3057\u3063\u304B\u308A\u5206\u5225\u3057\u3066\u6368\u3066\u3066\u304F\u308B\u306D\uFF01\u300D"
        npcResponseRomaji: (Yokatta! Kan ya pettobotoru o shikkari bunbetsu shite
          sutete kuru ne!)
        npcResponseEnglish: '"Great! I''ll sort the cans and plastic bottles properly
          and throw them away!"'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  - locationName: LampuMerah
    pointTransform: {fileID: 1184413681}
    locationQuestions:
    - npcName: Rin
      avatarPortrait: {fileID: 0}
      roleTag: Pedestrian
      jlptTag: "Formality: Casual & Friendly \u2022 JLPT N5"
      questionJapanese: "\u300C\u8ECA\u306F\u901A\u3063\u3066\u306A\u3044\u3051\u3069\u3001\u9752\u306B\u306A\u308B\u307E\u3067\u5F85\u3068\u3046\u306D\u3002\u300D"
      questionRomaji: (Kuruma wa toottenai kedo, ao ni naru made matou ne.)
      questionEnglish: '"There are no cars passing, but let''s wait until the light
        turns green."'
      choices:
      - choiceText: "\u300C\u8ECA\u304C\u597D\u304D\u3067\u3059\u3002\u300D"
        choiceRomaji: (Kuruma ga suki desu.)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u79C1\u3082\u8ECA\u306F\u597D\u304D\u3060\u3051\u3069\u3001\u4ECA\u306F\u4EA4\u901A\u30EB\u30FC\u30EB\u306E\u8A71\u3060\u3088\u301C\uFF01\u300D"
        npcResponseRomaji: (Watashi mo kuruma wa suki dakedo, ima wa koutsuu ruuru
          no hanashi da yo~)
        npcResponseEnglish: "\"I like cars too, but right now we're talking about
          traffic rules\u301C!\""
      - choiceText: "\u300C\u305D\u3046\u3067\u3059\u306D\u3001\u5F85\u3061\u307E\u3057\u3087\u3046\uFF01\u300D"
        choiceRomaji: (Sou desu ne, machimashou!)
        isCorrect: 1
        scoreReward: 0
        npcResponse: "\u300C\u3046\u3093\uFF01\u8AB0\u3082\u898B\u3066\u3044\u306A\u304F\u3066\u3082\u30DE\u30CA\u30FC\u3092\u5B88\u308B\u306E\u304C\u5927\u4E8B\u3060\u3088\u306D\uFF01\u300D"
        npcResponseRomaji: (Un! Dare mo mite inakutemo manaa o mamoru no ga daiji
          da yo ne!)
        npcResponseEnglish: '"Yup! Following manners even when no one is watching
          is what''s truly important!"'
      - choiceText: "\u300C\u6025\u3044\u3067\u6E21\u3063\u3061\u3083\u304A\u3046\uFF01\u300D"
        choiceRomaji: (Isoide watatchaou!)
        isCorrect: 0
        scoreReward: 0
        npcResponse: "\u300C\u30C0\u30E1\u30C0\u30E1\u5371\u306A\u3044\u3088\uFF01\u6025\u306B\u8ECA\u304C\u66F2\u304C\u3063\u3066\u304F\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u304B\u3089\u306D\u3002\u300D"
        npcResponseRomaji: (Dame dame abunai yo! Kyuu ni kuruma ga magatte kuru kamoshirenai
          kara ne.)
        npcResponseEnglish: '"No no, that''s dangerous! A car might suddenly turn
          the corner."'
      scoreReward: 100
      voiceSound: {fileID: 0}
      basePitch: 1
  numberOfNpcs: 7
  lockCanonicalSpawnPoints: 1
