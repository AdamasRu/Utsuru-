  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <b>Ch\u014Donpu ( \u30FC / Long Vowel ):</b> A horizontal bar extending
    the vowel sound in foreign loanwords.\n  <i>Example:</i> \u30B3\u30FC\u30D2\u30FC
    (k\u014Dh\u012B = coffee), \u30B1\u30FC\u30AD (k\u0113ki = cake), \u30CE\u30FC\u30C8
    (n\u014Dto = notebook)\n\n\u2022 <b>Sokuon Katakana ( \u30C3 / Small Tsu ):</b>
    Pauses to double consonants in loanwords.\n  <i>Example:</i> \u30B3\u30C3\u30D7
    (koppu = cup), \u30D9\u30C3\u30C9 (beddo = bed)\n\n\u2022 <b>Modern Loanword
    Combinations:</b> Used for non-Japanese foreign names and terms:\n  \u2022 \u30F4
    (vu)  \u2022 \u30D5\u30A1 (fa)  \u2022 \u30D5\u30A3 (fi)  \u2022 \u30D5\u30A7
    (fe)  \u2022 \u30D5\u30A9 (fo)\n  \u2022 \u30C6\u30A3 (ti)  \u2022 \u30C7\u30A3
    (di)  \u2022 \u30B7\u30A7 (she)  \u2022 \u30B8\u30A7 (je)  \u2022 \u30C1\u30A7
    (che)"
  m_isRightToLeft: 0
